# ==========================================
# VARIÁVEIS DE AMBIENTE - ROBÔ DO BRICK
# ==========================================

# Google Gemini API (Google AI Studio - Free Tier)
# Obtenha gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui

# Telegram Bot API
# Crie seu bot no Telegram falando com o @BotFather
TELEGRAM_BOT_TOKEN=seu_token_do_botfather_aqui
# Descubra seu ID numérico falando com o @userinfobot
TELEGRAM_CHAT_ID=seu_chat_id_numerico_aqui

# Caminho para o Perfil de Usuário do Google Chrome (Windows)
# Geralmente: C:\Users\<SeuUsuario>\AppData\Local\Google\Chrome\User Data
CHROME_USER_DATA_DIR=C:\Users\Brunin\AppData\Local\Google\Chrome\User Data

# URL de busca do Facebook Marketplace (Ex: Eletrônicos em São Paulo ordenados por Mais Recentes)
# Altere 'saopaulo' para sua cidade se desejar (ex: 'rio', 'curitiba', 'portoalegre', etc.)
MARKETPLACE_URL=https://www.facebook.com/marketplace/saopaulo/electronics?sortBy=creation_time_descend
